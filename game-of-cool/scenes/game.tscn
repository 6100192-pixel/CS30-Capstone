[sub_resource type="GDScript" id="GDScript_5jxly"]
script/source = "extends GPUParticles2D

func spawnparticles(start: Vector2, target: Vector2) -> void:
	global_position = start

	var direction = (target - start).normalized()

	var material = process_material as ParticleProcessMaterial
	material.direction = Vector3(direction.x, direction.y, 0)

	restart()
	emitting = true
"

